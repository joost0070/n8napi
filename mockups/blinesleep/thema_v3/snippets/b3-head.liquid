{%- comment -%}
  Bline v3: eigen lettertypen (lokaal, geen Google), stijl en script voor de v3-secties.
{%- endcomment -%}
<style>
  @font-face { font-family: 'B3 Poppins'; src: url({{ 'b3-poppins-400.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'B3 Poppins'; src: url({{ 'b3-poppins-500.woff2' | asset_url }}) format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'B3 Poppins'; src: url({{ 'b3-poppins-600.woff2' | asset_url }}) format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'B3 Serif'; src: url({{ 'b3-instrument-serif-400i.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
</style>
<link rel="preload" href="{{ 'b3-poppins-400.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'b3-poppins-600.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{{ 'bline-v3.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bline-v3.js' | asset_url }}" defer="defer"></script>

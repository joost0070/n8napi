{% comment %}
  Upsell in de winkelwagenlade, onder het eerste leeskussen: een reservehoes in dezelfde kleur als het kussen (voor de wasdag), als compacte productregel. Is die kleur op, dan een andere kleur.
  De automatische korting "Extra hoes: €9,99 korting" rekent zelf. Niet tonen als er al een hoes in de winkelwagen ligt of als er meer dan één kussen in ligt.
  Gebruik: render 'bline-upsell', item: item
{% endcomment %}
{%- liquid
  assign heeft_hoes = false
  assign kussens = 0
  for regel in cart.items
    if regel.product.handle contains 'hoes-'
      assign heeft_hoes = true
    endif
    if regel.product.handle contains 'leeskussen-'
      assign kussens = kussens | plus: regel.quantity
    endif
  endfor
  assign kleur = item.product.metafields.bline.kleur_naam.value
  assign doel = kleur | downcase
  assign hoes = null
  assign hoes_handle = 'hoes-' | append: doel
  if all_products[hoes_handle].available
    assign hoes = all_products[hoes_handle]
  endif
  if hoes == null
    assign eigen = 'hoes-' | append: kleur | downcase
    assign kandidaten = 'hoes-wit,hoes-beige,hoes-blauw,hoes-grijs,hoes-zwart' | split: ','
    for h in kandidaten
      if hoes == null and h != eigen and all_products[h].available
        assign hoes = all_products[h]
      endif
    endfor
  endif
  if hoes != null
    assign hoes_variant = hoes.selected_or_first_available_variant
    assign hoes_kleur = hoes.metafields.bline.kleur_naam.value
  endif
-%}
{%- comment -%} De hoeskorting geldt alleen bij precies één kussen: bij twee kussens geldt al de kussenkorting en die stapelen niet. {%- endcomment -%}
{%- if heeft_hoes == false and hoes != null and kussens == 1 -%}
  {%- assign hoes_prijs_na = hoes_variant.price | minus: 999 -%}
  <tr class="bline-upsell" role="row">
    <td class="bline-upsell__cel" colspan="4" role="cell">
      <div class="bline-upsell__kaart">
        <a href="{{ hoes.url }}" class="bline-upsell__foto" tabindex="-1" aria-hidden="true">
          {%- if hoes.featured_image -%}{{ hoes.featured_image | image_url: width: 140 | image_tag: width: 64, height: 64, loading: 'lazy', alt: '' }}{%- endif -%}
        </a>
        <div class="bline-upsell__info">
          <span class="bline-upsell__oog">Reservehoes voor de wasdag</span>
          <a href="{{ hoes.url }}" class="bline-upsell__naam">Hoes {{ hoes_kleur | downcase }}</a>
          <span class="bline-upsell__prijs"><s>{{ hoes_variant.price | money }}</s> <b>{{ hoes_prijs_na | money }}</b></span>
        </div>
        <button
          type="button"
          class="bline-upsell__knop"
          data-bline-upsell="{{ hoes_variant.id }}"
          aria-label="Hoes {{ hoes_kleur | downcase }} toevoegen voor {{ hoes_prijs_na | money }}"
        >+</button>
      </div>
    </td>
  </tr>
{%- endif -%}

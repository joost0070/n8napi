{%- comment -%} Bline v3: tekstkaarten op getinte achtergrond (tips, verzorging, wat er komt). {%- endcomment -%}
<section class="b3 b3-sectie b3-sectie--{{ section.settings.achtergrond }}">
  <div class="b3-sectie__in">
    {%- if section.settings.oog != blank -%}<p class="b3-oog">{{ section.settings.oog }}</p>{%- endif -%}
    {%- if section.settings.kop != blank -%}<h2 class="b3-kop">{{ section.settings.kop }}</h2>{%- endif -%}
    <div class="b3-tegels">
      {%- for block in section.blocks -%}
        <div class="b3-tegelkaart b3-getal--{% cycle 'zand', 'mist', 'steen' %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icoon != blank -%}<span class="b3-tegelkaart__icoon">{% render 'b3-icoon', naam: block.settings.icoon %}</span>{%- endif -%}
          <h3>{{ block.settings.titel }}</h3>
          <div>{{ block.settings.tekst }}</div>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="b3-tegelkaart__link">{{ block.settings.link_label }} {% render 'b3-icoon', naam: 'pijl' %}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bline v3: tegels",
  "settings": [
    { "type": "text", "id": "oog", "label": "Bovenregel" },
    { "type": "inline_richtext", "id": "kop", "label": "Kop" },
    { "type": "select", "id": "achtergrond", "label": "Achtergrond", "default": "warm", "options": [ { "value": "warm", "label": "Warm" }, { "value": "wit", "label": "Wit" } ] }
  ],
  "blocks": [
    { "type": "tegel", "name": "Tegel", "settings": [
      { "type": "select", "id": "icoon", "label": "Icoon", "default": "check", "options": [
        { "value": "check", "label": "Vinkje" }, { "value": "was", "label": "Wassen" }, { "value": "telefoon", "label": "Telefoon" }, { "value": "maat", "label": "Maat" },
        { "value": "boek", "label": "Boek" }, { "value": "veer", "label": "Veer" }, { "value": "rits", "label": "Rits" }, { "value": "terug", "label": "Retour" }, { "value": "klok", "label": "Klok" } ] },
      { "type": "text", "id": "titel", "label": "Titel" },
      { "type": "richtext", "id": "tekst", "label": "Tekst" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "link_label", "label": "Linktekst" }
    ] }
  ],
  "presets": [{ "name": "Bline v3: tegels" }]
}
{% endschema %}

{%- comment -%}
  Bline v3: score met verdeling. Bron: bol Ratings API, 05-10-2026, 13 reviews (9 x 5, 3 x 4, 0 x 3, 1 x 2, 0 x 1), gemiddeld 4,54.
  Geen reviewteksten van bol overnemen. Eigen reviews (Judge.me) komen eronder zodra ze er zijn.
{%- endcomment -%}
<section class="b3 b3-sectie b3-sectie--{{ section.settings.achtergrond }}">
  <div class="b3-sectie__in">
    <p class="b3-oog">{{ section.settings.oog }}</p>
    <h2 class="b3-kop">{{ section.settings.kop }}</h2>
    <div class="b3-score">
      <div>
        <div class="b3-score__groot">4,5</div>
        <div class="b3-score__sterren" aria-hidden="true">{% for i in (1..4) %}{% render 'b3-ster' %}{% endfor %}<svg class="b3-ster" width="14" height="14" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><defs><linearGradient id="b3-ster-half"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#b3-ster-half)" d="M10 1.5l2.6 5.5 6 .7-4.4 4.1 1.1 6-5.3-3-5.3 3 1.1-6L1.4 7.7l6-.7z"/></svg></div>
        <div class="b3-score__bron">{%- assign bol_ean = '8720892687241' -%}{%- if product and product.selected_or_first_available_variant.barcode != blank -%}{%- assign bol_ean = product.selected_or_first_available_variant.barcode -%}{%- endif -%}<a href="https://www.bol.com/nl/nl/s/?searchtext={{ bol_ean }}" target="_blank" rel="noopener">13 reviews op bol.com</a></div>
      </div>
      <div aria-label="Verdeling van de sterren">
        {%- assign rijen = '5 sterren:9,4 sterren:3,3 sterren:0,2 sterren:1,1 ster:0' | split: ',' -%}
        {%- for r in rijen -%}
          {%- assign d = r | split: ':' -%}
          {%- assign pct = d[1] | times: 100 | divided_by: 13 -%}
          <div class="b3-score__rij"><span>{{ d[0] }}</span><span class="b3-score__balk"><i style="width: {{ pct }}%"></i></span><span>{{ d[1] }}</span></div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bline v3: score",
  "settings": [
    { "type": "text", "id": "oog", "label": "Bovenregel", "default": "Wat kopers vinden" },
    { "type": "inline_richtext", "id": "kop", "label": "Kop", "default": "Al <em>gewaardeerd</em> op bol.com" },
    { "type": "select", "id": "achtergrond", "label": "Achtergrond", "default": "warm", "options": [ { "value": "warm", "label": "Warm" }, { "value": "wit", "label": "Wit" } ] }
  ],
  "presets": [{ "name": "Bline v3: score" }]
}
{% endschema %}

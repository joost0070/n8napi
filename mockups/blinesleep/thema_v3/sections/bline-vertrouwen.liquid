{%- comment -%} Bline v2: vertrouwensband, vier iconen met tekst. {%- endcomment -%}
<div class="bline-vertrouwen color-{{ section.settings.color_scheme }} gradient">
  <ul class="bline-vertrouwen__lijst page-width" role="list">
    <li><svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M2 8h17v13H2zM19 12h6l4 5v4h-10z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="8" cy="23" r="2.6" fill="#fff" stroke="currentColor" stroke-width="1.8"/><circle cx="24" cy="23" r="2.6" fill="#fff" stroke="currentColor" stroke-width="1.8"/></svg><span><strong>Gratis verzending</strong> in NL en BE</span></li>
    <li><svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 9v7l5 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span><strong>{{ settings.bline_levertijd_tekst | default: 'Binnen 1-2 werkdagen in huis' | escape }}</strong></span></li>
    <li><svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M5 9h22l-2 18H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M5 9l2-4h18l2 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 17c2-2 4 2 6 0s4 2 6 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span><strong>Hoes wasbaar</strong> op 30 °C</span></li>
    <li><svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M8 12h14a6 6 0 010 12H11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 7l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong>14 dagen</strong> bedenktijd</span></li>
  </ul>
</div>

{% schema %}
{
  "name": "Bline vertrouwensband",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurenschema", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Bline vertrouwensband" }]
}
{% endschema %}

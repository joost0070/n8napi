{%- comment -%}
  Bline v3: beeld of video met korte punten. Video komt uit de media van een product (bijvoorbeeld Wit).
{%- endcomment -%}
<section class="b3 b3-sectie b3-sectie--{{ section.settings.achtergrond }}">
  <div class="b3-sectie__in b3-verhaal{% if section.settings.om %} b3-verhaal--om{% endif %}">
    <div class="b3-verhaal__media">
      {%- assign vp = all_products[section.settings.video_product] -%}
      {%- assign video = vp.media | where: 'media_type', 'video' | first -%}
      {%- if section.settings.video_product != blank and video -%}
        {%- assign bron = video.sources | where: 'format', 'mp4' | where: 'height', 720 | first -%}
        {%- unless bron -%}{%- assign bron = video.sources | where: 'format', 'mp4' | last -%}{%- endunless -%}
        <video playsinline muted loop autoplay preload="none" poster="{{ video.preview_image | image_url: width: 1100 }}" aria-label="{{ video.alt | escape }}"><source src="{{ bron.url }}" type="video/mp4"></video>
      {%- elsif section.settings.beeld != blank -%}
        {{ section.settings.beeld | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 1000, 1400', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.beeld.alt }}
      {%- endif -%}
    </div>
    <div>
      <p class="b3-oog">{{ section.settings.oog }}</p>
      <h2 class="b3-kop">{{ section.settings.kop }}</h2>
      {%- if section.settings.tekst != blank -%}<p class="b3-intro">{{ section.settings.tekst }}</p>{%- endif -%}
      <ul class="b3-verhaal__punten" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'b3-icoon', naam: block.settings.icoon %}<div><b>{{ block.settings.kop }}</b><span>{{ block.settings.tekst }}</span></div></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.knop != blank -%}
        <a href="#" class="b3-knop{% if section.settings.achtergrond == 'donker' %} b3-knop--licht{% endif %}" data-b3-zet-kleur="{{ section.settings.knop_kleur }}">{{ section.settings.knop }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bline v3: beeld en punten",
  "settings": [
    { "type": "text", "id": "video_product", "label": "Video uit product (handle)" },
    { "type": "image_picker", "id": "beeld", "label": "Beeld (als er geen video is)" },
    { "type": "checkbox", "id": "om", "label": "Beeld rechts", "default": false },
    { "type": "text", "id": "oog", "label": "Bovenregel" },
    { "type": "inline_richtext", "id": "kop", "label": "Kop", "default": "Zie hem <em>in actie</em>" },
    { "type": "text", "id": "tekst", "label": "Tekst" },
    { "type": "text", "id": "knop", "label": "Knop" },
    { "type": "text", "id": "knop_kleur", "label": "Knop zet kleur", "default": "beige" },
    { "type": "select", "id": "achtergrond", "label": "Achtergrond", "default": "wit", "options": [ { "value": "warm", "label": "Warm" }, { "value": "wit", "label": "Wit" }, { "value": "donker", "label": "Donker" } ] }
  ],
  "blocks": [
    { "type": "punt", "name": "Punt", "settings": [
      { "type": "select", "id": "icoon", "label": "Icoon", "default": "check", "options": [
        { "value": "check", "label": "Vinkje" }, { "value": "telefoon", "label": "Telefoon" }, { "value": "rits", "label": "Rits" }, { "value": "was", "label": "Wassen" },
        { "value": "boek", "label": "Boek" }, { "value": "maat", "label": "Maat" }, { "value": "veer", "label": "Veer" }, { "value": "terug", "label": "Retour" }, { "value": "truck", "label": "Truck" }, { "value": "klok", "label": "Klok" } ] },
      { "type": "text", "id": "kop", "label": "Kop" },
      { "type": "text", "id": "tekst", "label": "Tekst" }
    ] }
  ],
  "presets": [{ "name": "Bline v3: beeld en punten" }]
}
{% endschema %}
